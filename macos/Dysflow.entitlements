<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Les droits de l'app signée avec le runtime durci (exigé pour la
     notarisation). Le runtime durci coupe le micro sauf demande : la dictée
     en a besoin. Rien d'autre : ni JIT, ni bibliothèques d'autres équipes. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
