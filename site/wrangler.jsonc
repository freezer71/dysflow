{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Le nom doit être celui du Worker relié au dépôt dans le tableau de bord Cloudflare.
	"name": "dysflow",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-10-26",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// Les branches autres que main se déploient en aperçu (`wrangler preview`),
	// qui exige ce bloc, même vide. La commande de ces branches, dans le
	// tableau de bord, doit construire avant :
	// npm ci && npx opennextjs-cloudflare build && npx wrangler preview
	"previews": {}
}
